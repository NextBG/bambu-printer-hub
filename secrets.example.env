# copy to secrets.env, chmod 600; generate values with: python3 -c "import secrets;print(secrets.token_urlsafe(24))"
HUB_PASSWORD=change-me
HUB_BRIDGE_TOKEN=change-me
HUB_COOKIE_KEY=change-me
HUB_PORT=8446
# HUB_CERT / HUB_KEY (TLS) are set in deploy/printer-hub.service; omit both to serve plain HTTP (e.g. behind nginx)
